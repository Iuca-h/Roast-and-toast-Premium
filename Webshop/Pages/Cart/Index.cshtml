
@page
@model Webshop.Pages.Cart.IndexModel

@{
    ViewData["Title"] = "Shopping Cart";
}

<div class="container mt-4">

    <h1 class="mb-4">Shopping Cart</h1>

    @if (Model.ShoppingCart == null ||
         !Model.ShoppingCart.Items.Any())
    {
        <div class="alert alert-info">
            Your shopping cart is empty.
        </div>

        <a asp-page="/Products/Index"
           class="btn btn-primary">
            Continue Shopping
        </a>
    }
    else
    {
        <div class="row">

            <div class="col-lg-8">

                @foreach (var item in Model.ShoppingCart.Items)
                {
                    <div class="card mb-3 shadow-sm">

                        <div class="card-body">

                            <div class="row align-items-center">

                                <div class="col-md-4">

                                    <h5>@item.Product.Name</h5>

                                    <p class="text-muted mb-0">
                                        Model: @item.Product.Model
                                    </p>

                                    <p class="text-primary fw-bold mt-2 mb-0">
                                        €@((item.Product.PriceCents / 100m).ToString("N2"))
                                    </p>

                                </div>

                                <div class="col-md-4">

                                    <span class="text-muted">
                                        Quantity
                                    </span>

                                    <div class="d-flex align-items-center gap-2 mt-2">

                                        <form method="post"
                                              asp-page-handler="Decrease"
                                              asp-route-id="@item.Id">

                                            <button type="submit"
                                                    class="btn btn-outline-secondary btn-sm">
                                                −
                                            </button>

                                        </form>

                                        <strong>@item.Quantity</strong>

                                        <form method="post"
                                              asp-page-handler="Increase"
                                              asp-route-id="@item.Id">

                                            <button type="submit"
                                                    class="btn btn-outline-secondary btn-sm">
                                                +
                                            </button>

                                        </form>

                                    </div>

                                </div>

                                <div class="col-md-4">

                                    <span class="text-muted">
                                        Subtotal
                                    </span>

                                    <p class="fw-bold text-primary mb-0">
                                        €@((item.Product.PriceCents *
                                            (decimal)item.Quantity / 100m).ToString("N2"))
                                    </p>

                                </div>

                            </div>

                        </div>

                    </div>
                }

            </div>

            <div class="col-lg-4">

                <div class="card shadow-sm">

                    <div class="card-body">

                        <h4>Order Summary</h4>

                        <hr />

                        <div class="d-flex justify-content-between">

                            <span>Total:</span>

                            <strong class="text-primary fs-4">
                                €@Model.TotalPrice.ToString("N2")
                            </strong>

                        </div>

                        <hr />

                        <a asp-page="/Checkout/Index"
                           class="btn btn-success w-100 mb-2">
                            Proceed to Checkout
                        </a>

                        <a asp-page="/Products/Index"
                           class="btn btn-outline-secondary w-100">
                            Continue Shopping
                        </a>

                    </div>

                </div>

            </div>

        </div>
    }

</div>
