@page
@model PrivacyModel
@{
    ViewData["Title"] = "Privacy Policy";
}

<div class="container">

    <div class="mb-5">
        <h1 class="login-title mt-3">Privacy <span class="text-accent">Policy.</span></h1>
        <p class="login-description mt-3">
            Your privacy matters to us. Learn how Roast & Toast collects,
            uses and protects your personal information.
        </p>
        <div class="privacy-updated mt-4">
            <i class="bi bi-calendar3 me-2"></i>
            Last updated: November 2026
        </div>
    </div>

    <div class="privacy-card p-4 p-lg-5">

        <section class="privacy-section">
            <span class="privacy-number">01</span>
            <h2>Introduction</h2>
            <p>
                Roast & Toast respects your privacy and is committed to
                protecting your personal data. This Privacy Policy explains
                what information we collect when you use our webshop and
                how we handle that information.
            </p>
        </section>

        <section class="privacy-section">
            <span class="privacy-number">02</span>
            <h2>Information We Collect</h2>
            <p>When you use our webshop, we may collect the following information:</p>
            <ul>
                <li><strong>Account information:</strong> Your name, email address and account credentials.</li>
                <li><strong>Contact information:</strong> Your phone number and shipping address.</li>
                <li><strong>Order information:</strong> Products purchased, order history and delivery details.</li>
                <li><strong>Payment information:</strong> Payment status and transaction references. We do not store full credit card numbers or CVV codes.</li>
            </ul>
        </section>

        <section class="privacy-section">
            <span class="privacy-number">03</span>
            <h2>How We Use Your Information</h2>
            <p>We use your personal information to:</p>
            <ul>
                <li>Create and manage customer accounts.</li>
                <li>Process and manage orders.</li>
                <li>Arrange deliveries and communicate order updates.</li>
                <li>Respond to questions and customer support requests.</li>
                <li>Maintain the security and functionality of our webshop.</li>
            </ul>
        </section>

        <section class="privacy-section">
            <span class="privacy-number">04</span>
            <h2>Payment Security</h2>
            <p>
                Payment information is handled as part of the checkout process.
                We may retain transaction details, payment status and limited
                card information, such as the last four digits, for order
                administration and reference purposes.
            </p>
            <p>
                Never share your card details or security codes with anyone.
            </p>
        </section>

        <section class="privacy-section">
            <span class="privacy-number">05</span>
            <h2>Data Sharing</h2>
            <p>
                We do not sell your personal information. Your data may be
                shared with service providers when necessary to operate the
                webshop, process payments, deliver orders or provide technical
                support.
            </p>
        </section>

        <section class="privacy-section">
            <span class="privacy-number">06</span>
            <h2>Data Retention</h2>
            <p>
                We retain personal information only for as long as necessary
                to provide our services, manage customer accounts, fulfil
                legal obligations and resolve potential disputes.
            </p>
        </section>

        <section class="privacy-section">
            <span class="privacy-number">07</span>
            <h2>Your Rights</h2>
            <p>
                Depending on applicable data protection laws, you may have
                the right to:
            </p>
            <ul>
                <li>Request access to your personal information.</li>
                <li>Request correction of inaccurate information.</li>
                <li>Request deletion of your personal data.</li>
                <li>Object to or restrict certain processing activities.</li>
                <li>Request a copy of your data.</li>
            </ul>
        </section>

        <section class="privacy-section">
            <span class="privacy-number">08</span>
            <h2>Cookies</h2>
            <p>
                Our webshop may use cookies and similar technologies to
                maintain essential functionality, such as keeping you signed
                in and managing your shopping session.
            </p>
        </section>

        <section class="privacy-section">
            <span class="privacy-number">09</span>
            <h2>Contact</h2>
            <p>
                If you have questions about this Privacy Policy or how your
                personal information is handled, please contact us.
            </p>
            <a href="mailto:info@example.com" class="privacy-contact">
                <i class="bi bi-envelope me-2"></i>
                Contact our team
                <i class="bi bi-arrow-up-right ms-2"></i>
            </a>
        </section>

    </div>

    <div class="privacy-footer mt-4">
        <span>ROAST & TOAST</span>
        <span>YOUR TRUST MATTERS.</span>
    </div>

</div>
