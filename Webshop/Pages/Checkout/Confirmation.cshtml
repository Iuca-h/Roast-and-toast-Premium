
@page
@model Webshop.Pages.Checkout.ConfirmationModel

@{
    ViewData["Title"] = "Order Confirmation";
}

@if (Model.Order != null && Model.Payment != null)
{
    <div class="container py-5">

        <div class="confirmation-header text-center mb-5">
            <div class="confirmation-success-icon">
                <i class="bi bi-check-lg"></i>
            </div>

            <span class="login-label">PAYMENT COMPLETED</span>

            <h1 class="login-title mt-3">
                Thank you<span>.</span>
            </h1>

            <p class="login-description mx-auto">
                Your payment has been successfully processed.
                Your order is now confirmed.
            </p>
        </div>

        @if (!string.IsNullOrEmpty(Model.EmailWarning))
        {
            <div class="alert alert-warning rounded-0 mb-4">
                @Model.EmailWarning
            </div>
        }

        <div class="confirmation-wrapper">

            <div class="receipt confirmation-receipt">

                <div class="receipt-header">

                    <span class="receipt-brand">ROAST & TOAST</span>

                    <span class="receipt-subtitle">
                        ORDER RECEIPT
                    </span>

                    <span class="receipt-number">
                        #@Model.Order.OrderNumber
                    </span>

                </div>

                <div class="receipt-divider"></div>

                <div class="confirmation-meta">

                    <div>
                        <span>ORDER DATE</span>
                        <strong>
                            @DateTime.SpecifyKind(
                                Model.Order.CreatedAt,
                                DateTimeKind.Utc
                            ).ToLocalTime().ToString("dd MMM yyyy, HH:mm")
                        </strong>
                    </div>

                    <div>
                        <span>ORDER STATUS</span>
                        <strong>@Model.Order.OrderStatus</strong>
                    </div>

                </div>

                <div class="receipt-divider"></div>

                <div class="confirmation-section-label">
                    ORDERED PRODUCTS
                </div>

                @foreach (var item in Model.Order.Items)
                {
                    <div class="receipt-item">

                        <div class="receipt-item-info">
                            <span>@item.ProductName</span>
                            <small>Quantity: @item.Quantity</small>
                        </div>

                        <span class="receipt-price">
                            @((item.SubtotalCents / 100m).ToString("C"))
                        </span>

                    </div>
                }

                <div class="receipt-divider"></div>

                <div class="receipt-total">
                    <span>TOTAL</span>

                    <strong class="price">
                        @((Model.Order.TotalPriceCents / 100m).ToString("C"))
                    </strong>
                </div>

                <div class="receipt-divider"></div>

                <div class="confirmation-section-label">
                    PAYMENT INFORMATION
                </div>

                <div class="confirmation-payment-info">

                    <div>
                        <span>Payment method</span>
                        <strong>@Model.Payment.PaymentMethod</strong>
                    </div>

                    <div>
                        <span>Card</span>
                        <strong>
                            @Model.Payment.CardBrand ending in @Model.Payment.CardLast4
                        </strong>
                    </div>

                    <div>
                        <span>Transaction ID</span>
                        <strong class="confirmation-transaction">
                            @Model.Payment.TransactionId
                        </strong>
                    </div>

                    <div>
                        <span>Payment status</span>
                        <strong>@Model.Payment.PaymentStatus</strong>
                    </div>

                </div>

                <div class="confirmation-paid-stamp">
                    PAID
                </div>

                <div class="receipt-footer">
                    <span>THANK YOU FOR YOUR ORDER</span>
                    <span>ROAST & TOAST PREMIUM</span>
                    <span>BUILT FOR BETTER BAKING.</span>
                </div>

            </div>

        </div>

        <div class="text-center mt-5">
            <a asp-page="/Index" class="btn btn-primary confirmation-button">
                Continue Shopping
                <span>↗</span>
            </a>
        </div>

    </div>
}
