@page
@model Webshop.Pages.FAQModel

@{
    ViewData["Title"] = "FAQ";
}

<div class="container">

    <!-- Header -->
    <div class="mb-5">
        <h1 class="login-title mt-3">
            Frequently Asked <span class="text-accent">Questions.</span>
        </h1>

        <p class="login-description mt-3">
            Find answers to the most common questions about our bakery
            equipment, orders, delivery and services.
        </p>

        <div class="privacy-updated mt-4">
            <i class="bi bi-question-circle me-2"></i>
            Everything you need to know about Roast & Toast
        </div>
    </div>

    <div class="privacy-card p-4 p-lg-5">

        <!-- Products -->
        <section class="privacy-section">
            <span class="privacy-number">01</span>
            <h2>Products & Equipment</h2>

            <div class="faq-item">
                <button class="faq-question"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#faq1"
                        aria-expanded="false"
                        aria-controls="faq1">
                    <span>What types of bakery equipment do you offer?</span>
                    <i class="bi bi-plus-lg faq-icon"></i>
                </button>

                <div id="faq1" class="collapse">
                    <div class="faq-answer">
                        We offer a wide range of professional bakery equipment,
                        including dough mixers, ovens, dough dividers, proofers,
                        bread slicers and other essential bakery machines.
                    </div>
                </div>
            </div>

            <div class="faq-item">
                <button class="faq-question collapsed"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#faq2"
                        aria-expanded="false"
                        aria-controls="faq2">
                    <span>Are your machines suitable for professional bakeries?</span>
                    <i class="bi bi-plus-lg faq-icon"></i>
                </button>

                <div id="faq2" class="collapse">
                    <div class="faq-answer">
                        Our equipment is designed for professional use
                        and supports bakeries of different sizes and
                        production capacities.
                    </div>
                </div>
            </div>

            <div class="faq-item">
                <button class="faq-question collapsed"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#faq3"
                        aria-expanded="false"
                        aria-controls="faq3">
                    <span>Where can I find product specifications?</span>
                    <i class="bi bi-plus-lg faq-icon"></i>
                </button>

                <div id="faq3" class="collapse">
                    <div class="faq-answer">
                        Each product page contains detailed specifications,
                        including capacity, power consumption, materials
                        and dimensions.
                    </div>
                </div>
            </div>
        </section>

        <!-- Orders -->
        <section class="privacy-section">
            <span class="privacy-number">02</span>
            <h2>Orders & Payments</h2>

            <div class="faq-item">
                <button class="faq-question collapsed"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#faq4"
                        aria-expanded="false"
                        aria-controls="faq4">
                    <span>How can I place an order?</span>
                    <i class="bi bi-plus-lg faq-icon"></i>
                </button>

                <div id="faq4" class="collapse">
                    <div class="faq-answer">
                        Browse our products, add the equipment you need
                        to your shopping cart and proceed to checkout.
                    </div>
                </div>
            </div>

            <div class="faq-item">
                <button class="faq-question collapsed"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#faq5"
                        aria-expanded="false"
                        aria-controls="faq5">
                    <span>Which payment methods are accepted?</span>
                    <i class="bi bi-plus-lg faq-icon"></i>
                </button>

                <div id="faq5" class="collapse">
                    <div class="faq-answer">
                        Available payment methods are displayed during
                        the checkout process.
                    </div>
                </div>
            </div>

            <div class="faq-item">
                <button class="faq-question collapsed"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#faq6"
                        aria-expanded="false"
                        aria-controls="faq6">
                    <span>Can I ask questions before purchasing?</span>
                    <i class="bi bi-plus-lg faq-icon"></i>
                </button>

                <div id="faq6" class="collapse">
                    <div class="faq-answer">
                        Absolutely! You can contact our team with any questions
                        about products, specifications or your order.
                    </div>
                </div>
            </div>
        </section>

        <!-- Delivery -->
        <section class="privacy-section">
            <span class="privacy-number">03</span>
            <h2>Delivery & Support</h2>

            <div class="faq-item">
                <button class="faq-question collapsed"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#faq7"
                        aria-expanded="false"
                        aria-controls="faq7">
                    <span>How long does delivery take?</span>
                    <i class="bi bi-plus-lg faq-icon"></i>
                </button>

                <div id="faq7" class="collapse">
                    <div class="faq-answer">
                        Delivery times depend on the product and destination.
                        Please contact us for more information about your order.
                    </div>
                </div>
            </div>

            <div class="faq-item">
                <button class="faq-question collapsed"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#faq8"
                        aria-expanded="false"
                        aria-controls="faq8">
                    <span>How can I contact customer support?</span>
                    <i class="bi bi-plus-lg faq-icon"></i>
                </button>

                <div id="faq8" class="collapse">
                    <div class="faq-answer">
                        You can reach us through our contact page.
                        Our team will be happy to help you.
                    </div>
                </div>
            </div>
        </section>

        <!-- Contact -->
        <section class="privacy-section">
            <span class="privacy-number">04</span>
            <h2>Still have questions?</h2>

            <p>
                Can't find the answer you're looking for?
                Get in touch with our team and we'll be happy to help.
            </p>

            <a asp-page="/Contact/Contact" class="privacy-contact">
                <i class="bi bi-envelope me-2"></i>
                Contact our team
                <i class="bi bi-arrow-up-right ms-2"></i>
            </a>
        </section>

    </div>

    <div class="privacy-footer mt-4">
        <span>ROAST & TOAST</span>
        <span>WE'RE HERE TO HELP.</span>
    </div>

</div>
