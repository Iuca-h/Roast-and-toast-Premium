<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Webshop</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Webshop.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap-icons.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&family=Zen+Dots&display=swap" rel="stylesheet">
</head>
<body>
    <header class="sticky-top mt-3 bg-transparent">
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light mb-3">
            <div class="container blur-bg border py-2 px-3">
                <a class="navbar-brand fw-bold special-heading text-blue" asp-area="" asp-page="/Index">webshop.</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1 fw-medium">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-page="/Products/Index">
                                products
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-page="/Cart/Index">
                                cart
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-page="/MyOrders/Index">
                                orders
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-page="/FAQ/FAQ">
                                faq
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-page="/Contact/Contact">
                                contact
                            </a>
                        </li>
                    }
                    @if (User.IsInRole("DBA") || User.IsInRole("Admin"))
                    {
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-page="/Admin/Index">dashboard</a>
                        </li>
                    }
                    </ul>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>
    
    <div class="container min-vh-100">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>
    
    <footer class="bg-blue text-light mt-5">
        <div class="container py-5">
            <div class="row g-4">
                <div class="col-12 col-md-6 col-lg-4">
                    <a class="footer-brand text-light text-decoration-none fw-bold" asp-area="" asp-page="/Index">
                        webshop.
                    </a>
                    
                    <p class="mt-3 mb-0">
                        Professional bakery equipment for businesses
                        that value quality, reliability and efficiency.
                    </p>
                </div>

                <!-- Explore -->
                <div class="col-6 col-md-3 col-lg-2">
                    <h6 class="footer-heading fw-bold text-uppercase mb-3">
                        Explore
                    </h6>

                    <ul class="list-unstyled">
                        <li class="mb-2">
                            <a class="footer-link" asp-area="" asp-page="/Index">
                                Home
                            </a>
                        </li>
                        <li class="mb-2">
                            <a class="footer-link" asp-area="" asp-page="/Products/Index">
                                Products
                            </a>
                        </li>
                        <li class="mb-2">
                            <a class="footer-link" asp-area="" asp-page="/Privacy">
                                Privacy
                            </a>
                        </li>
                    </ul>
                </div>

                <!-- Customer Service -->
                <div class="col-6 col-md-3 col-lg-3">
                    <h6 class="footer-heading fw-bold text-uppercase mb-3">
                        Customer Service
                    </h6>

                    <ul class="list-unstyled">
                        <li class="mb-2">
                            <a class="footer-link" asp-area="" asp-page="/Contact/Contact">
                                Contact Us
                            </a>
                        </li>
                        <li class="mb-2">
                            <a class="footer-link" asp-area="" asp-page="/FAQ/FAQ">
                                FAQ
                            </a>
                        </li>
                    </ul>
                </div>

                <!-- Contact -->
                <div class="col-12 col-md-6 col-lg-3">
                    <h6 class="footer-heading fw-bold text-uppercase mb-3">
                        Get in Touch
                    </h6>

                    <p class="mb-2">
                        Have questions about our products?
                        We are happy to help.
                    </p>

                    <a class="footer-link" href="mailto:info@example.com">
                        info@example.com
                    </a>
                </div>

            </div>

            <!-- Bottom -->
            <div class="border-top border-light border-opacity-25 border-2 mt-5 pt-4">
                <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2">

                    <p class="small mb-0">
                        &copy; @DateTime.Now.Year Webshop.
                        All rights reserved.
                    </p>

                    <p class="small mb-0">
                        Quality equipment. Reliable solutions.
                    </p>

                </div>
            </div>

        </div>
    </footer>


    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
