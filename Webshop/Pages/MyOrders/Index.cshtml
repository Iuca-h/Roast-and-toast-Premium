@page
@model Webshop.Pages.MyOrders.IndexModel

@{
    ViewData["Title"] = "My Orders";
}

<div class="container">

    <div class="mb-5">
        <h1 class="products-title mt-3">
            My Orders<span>.</span>
        </h1>

        <p class="login-description">
            Keep track of your purchases and payment history.
        </p>
    </div>

    @if (Model.Orders.Count == 0)
    {
        <div class="orders-empty p-4 p-md-5 text-center">

            <div class="orders-empty-icon mb-4">
                <i class="bi bi-box-seam"></i>
            </div>

            <span class="login-label">NOTHING HERE YET</span>

            <h3 class="orders-empty-title mt-3">
                No orders yet<span>.</span>
            </h3>

            <p class="login-description mx-auto mb-4">
                You haven't placed any orders yet.
                Explore our equipment and find what you need.
            </p>

            <a asp-page="/Products/Index"
               class="btn btn-primary orders-button">
                Start Shopping
                <span>↗</span>
            </a>

        </div>
    }
    else
    {
        <div class="d-flex justify-content-between align-items-center mb-4">
            <span class="login-label">
                ORDER HISTORY
            </span>

            <span class="orders-count">
                @Model.Orders.Count ORDERS
            </span>
        </div>

        <div class="d-flex flex-column gap-3">

            @foreach (var order in Model.Orders)
            {
                var payment = order.Payments
                    .OrderByDescending(p => p.CreatedAt)
                    .FirstOrDefault();

                <div class="order-card p-4">

                    <div class="row align-items-center g-4">

                        <div class="col-12 col-lg-3">

                            <span class="order-card-label">
                                ORDER NUMBER
                            </span>

                            <h5 class="order-card-number mt-2 mb-2">
                                #@order.OrderNumber
                            </h5>

                            <span class="order-card-date">
                                <i class="bi bi-calendar3 me-2"></i>
                                @DateTime.SpecifyKind(
                                    order.CreatedAt,
                                    DateTimeKind.Utc
                                ).ToLocalTime().ToString("dd MMMM yyyy, HH:mm")
                            </span>

                        </div>

                        <div class="col-6 col-md-4 col-lg-2">

                            <span class="order-card-label">
                                PRODUCTS
                            </span>

                            <div class="order-card-value mt-2">
                                <i class="bi bi-box-seam me-2"></i>
                                @order.Items.Sum(i => i.Quantity)
                                <span>items</span>
                            </div>

                        </div>

                        <div class="col-6 col-md-4 col-lg-2">

                            <span class="order-card-label">
                                TOTAL
                            </span>

                            <div class="order-card-price mt-2">
                                @((order.TotalPriceCents / 100m).ToString("C"))
                            </div>

                        </div>

                        <div class="col-6 col-md-4 col-lg-2">

                            <span class="order-card-label">
                                PAYMENT
                            </span>

                            <div class="order-card-value mt-2">
                                @(payment?.PaymentStatus ?? "Not available")
                            </div>

                        </div>

                        <div class="col-6 col-lg-3">

                            <span class="order-card-label">
                                ORDER STATUS
                            </span>

                            <div class="mt-2">
                                @if (order.OrderStatus == "Paid")
                                {
                                    <span class="order-status order-status-paid">
                                        <i class="bi bi-check-circle me-1"></i>
                                        Paid
                                    </span>
                                }
                                else
                                {
                                    <span class="order-status order-status-other">
                                        @order.OrderStatus
                                    </span>
                                }
                            </div>

                        </div>

                        <div class="col-12">
                            <div class="order-card-divider"></div>

                            <div class="d-flex justify-content-end">
                                <a asp-page="/MyOrders/Details"
                                   asp-route-id="@order.Id"
                                   class="btn btn-primary orders-button">
                                    View Details
                                    <span>↗</span>
                                </a>
                            </div>
                        </div>

                    </div>

                </div>
            }

        </div>
    }

</div>
