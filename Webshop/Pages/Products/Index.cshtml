@page
@model Webshop.Pages.Products.IndexModel

@{
    ViewData["Title"] = "Products";
}

<div class="container">

    <div class="products-heading mb-5">

        <h1 class="products-title mt-3">
            Bakery <span>Machines.</span>
        </h1>

        <p class="login-description">
            Professional equipment designed for quality, precision and efficiency.
        </p>
    </div>

    <div class="row g-4">

        @foreach (var product in Model.Products)
        {
            <div class="col-12 col-md-6 col-lg-4">

                <div class="card product-card h-100">

                    @if (product.ImageData != null)
                    {
                        <div class="product-image-wrapper">
                            <img src="/Products/Image/@product.Id"
                                 class="product-image"
                                 alt="@product.Name" />
                        </div>
                    }
                    else
                    {
                        <div class="product-image-wrapper product-image-empty">
                            <span>No image available</span>
                        </div>
                    }

                    <div class="card-body p-4 d-flex flex-column">

                        <div class="mb-2">
                            <span class="product-model">
                                @product.Model
                            </span>

                            <h5 class="product-name mt-2">
                                @product.Name
                            </h5>
                        </div>

                        <h4 class="product-price price mb-4">
                            € @((product.PriceCents / 100m).ToString("N2"))
                        </h4>

                        <div class="product-specifications mb-4">
                            <div>
                                <span>Capacity</span>
                                <strong>@product.Capacity</strong>
                            </div>

                            <div>
                                <span>Power</span>
                                <strong>@product.PowerKw kW</strong>
                            </div>
                        </div>

                        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mt-auto">

                            <a asp-page="./Details"
                               asp-route-id="@product.Id"
                               class="btn btn-primary product-button">
                                View details
                                <span>↗</span>
                            </a>

                            @if (product.Stock.StockAmount > 0)
                            {
                                <span class="product-stock in-stock">
                                    In stock: @product.Stock.StockAmount
                                </span>
                            }
                            else
                            {
                                <span class="product-stock out-of-stock">
                                    Out of stock
                                </span>
                            }

                        </div>

                    </div>
                </div>

            </div>
        }

    </div>
</div>