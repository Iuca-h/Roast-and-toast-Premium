@page "{id:int}"
@model Webshop.Pages.Products.DetailsModel

@{
    ViewData["Title"] = Model.Product?.Name ?? "Product Details";
}

<div class="container">

    <a asp-page="./Index" class="details-back-link mb-4">
        &larr; Back to Products
    </a>

    @if (TempData["CartMessage"] is string cartMessage)
    {
        <div class="alert alert-success rounded-0" role="alert">
            @cartMessage
        </div>
    }

    @if (TempData["CartError"] is string cartError)
    {
        <div class="alert alert-danger rounded-0" role="alert">
            @cartError
        </div>
    }

    <div class="row g-4 g-lg-5 mt-2">

        <!-- PRODUCT IMAGE -->
        <div class="col-12 col-lg-6">

            <div class="details-image-wrapper">

                @if (Model.Product!.ImageData != null)
                {
                    <img src="@Url.Page("/Products/Details", "Image", new { id = Model.Product.Id })"
                        alt="@Model.Product.Name" class="product-image">
                }
                else
                {
                    <div class="details-image-empty">
                        No image available
                    </div>
                }

            </div>

        </div>

        <!-- PRODUCT INFORMATION -->
        <div class="col-12 col-lg-6">

            <div class="details-information">

                <span class="login-label">PRODUCT DETAILS / 01</span>

                <h1 class="details-title mt-3">
                    @Model.Product.Name
                </h1>

                <p class="details-model mt-2">
                    Model: @Model.Product.Model
                </p>

                <h2 class="details-price my-4 price">
                    € @((Model.Product.PriceCents / 100m).ToString("N2"))
                </h2>

                <form method="post"
                      asp-page-handler="AddToCart"
                      asp-route-id="@Model.Product.Id"
                      class="details-cart-form mb-4">

                    <button type="submit" class="btn btn-primary details-cart-button">
                        <i class="bi bi-cart-plus"></i>
                        Add to Cart
                        <span>↗</span>
                    </button>

                    @if (Model.Product.Stock.StockAmount > 0)
                    {
                        <span class="details-stock in-stock">
                            In stock: @Model.Product.Stock.StockAmount
                        </span>
                    }
                    else
                    {
                        <span class="details-stock out-of-stock">
                            Out of stock
                        </span>
                    }

                </form>

                <div class="details-section">

                    <h4 class="details-section-title">Specifications</h4>

                    <table class="table details-table">
                        <tbody>
                            <tr>
                                <th>Capacity</th>
                                <td>@Model.Product.Capacity</td>
                            </tr>
                            <tr>
                                <th>Power</th>
                                <td>@Model.Product.PowerKw kW</td>
                            </tr>
                            <tr>
                                <th>Material</th>
                                <td>@Model.Product.Material</td>
                            </tr>
                            <tr>
                                <th>Dimensions</th>
                                <td>@Model.Product.Dimensions</td>
                            </tr>
                        </tbody>
                    </table>

                </div>

                <div class="details-section mt-4">

                    <h4 class="details-section-title">Description</h4>

                    <p class="details-description">
                        @Model.Product.Description
                    </p>

                </div>

            </div>

        </div>

    </div>
</div>