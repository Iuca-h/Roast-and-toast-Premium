@using Webshop.Data
@inject SignInManager<ApplicationUser> SignInManager

@{
    var hasExternalLogins =
        (await SignInManager.GetExternalAuthenticationSchemesAsync()).Any();
}

<div class="account-nav">
    <span class="login-label account-nav-label">ACCOUNT SETTINGS</span>

    <ul class="row row-cols-1 g-0">
        <li>
            <a class="@ManageNavPages.IndexNavClass(ViewContext)"
               id="profile"
               asp-page="./Index">
                <span>01</span> Profile
            </a>
        </li>

        <li>
            <a class="@ManageNavPages.EmailNavClass(ViewContext)"
               id="email"
               asp-page="./Email">
                <span>02</span> Email
            </a>
        </li>

        <li>
            <a class="@ManageNavPages.ChangePasswordNavClass(ViewContext)"
               id="change-password"
               asp-page="./ChangePassword">
                <span>03</span> Password
            </a>
        </li>

        @if (hasExternalLogins)
        {
            <li>
                <a class="@ManageNavPages.ExternalLoginsNavClass(ViewContext)"
                   id="external-login"
                   asp-page="./ExternalLogins">
                    <span>04</span> External logins
                </a>
            </li>
        }

        <li>
            <a class="@ManageNavPages.TwoFactorAuthenticationNavClass(ViewContext)"
               id="two-factor"
               asp-page="./TwoFactorAuthentication">
                <span>05</span> Two-factor authentication
            </a>
        </li>

        <li>
            <a class="@ManageNavPages.PersonalDataNavClass(ViewContext)"
               id="personal-data"
               asp-page="./PersonalData">
                <span>06</span> Personal data
            </a>
        </li>
    </ul>
</div>
