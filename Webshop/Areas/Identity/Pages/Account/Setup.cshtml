@page
@model Webshop.Areas.Identity.Pages.Account.SetupModel

@{
    ViewData["Title"] = "Account setup";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-12 col-md-10 col-lg-8 col-xl-7">

            <div class="setup-card p-4 p-md-5">

                <div class="setup-icon mb-4">
                    <i class="bi bi-shield-lock"></i>
                </div>

                <span class="login-label">FIRST-TIME ACCESS</span>

                <h1 class="login-title mt-2">Set up your account.</h1>

                <p class="login-description mb-4">
                    Enter the temporary password you were given, then create
                    a new secure password. After that, you'll connect an
                    authenticator app.
                </p>

                <div class="setup-notice mb-4">
                    <i class="bi bi-info-circle me-2"></i>
                    You'll need your temporary password to complete this setup.
                </div>

                <form method="post" id="setupForm">

                    <div asp-validation-summary="ModelOnly"
                         class="text-danger mb-3"></div>

                    <div class="mb-4">
                        <label asp-for="Input.TempPassword"
                               class="setup-label"></label>

                        <input asp-for="Input.TempPassword"
                               class="form-control setup-input"
                               autocomplete="current-password"
                               placeholder="Enter temporary password" />

                        <span asp-validation-for="Input.TempPassword"
                              class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Input.NewPassword"
                               class="setup-label"></label>

                        <input asp-for="Input.NewPassword"
                               class="form-control setup-input"
                               autocomplete="new-password"
                               placeholder="Create a new password" />

                        <div class="d-flex justify-content-between align-items-center mt-3">
                            <span class="setup-strength-label">PASSWORD STRENGTH</span>
                            <span class="setup-strength-hint">Live validation</span>
                        </div>

                        <div class="progress setup-progress mt-2">
                            <div id="passwordStrength"
                                 class="progress-bar"
                                 role="progressbar"
                                 style="width: 0%">
                            </div>
                        </div>

                        <div id="passwordMessage"
                             class="small mt-2"
                             aria-live="polite"></div>

                        <span asp-validation-for="Input.NewPassword"
                              class="text-danger small"></span>
                    </div>

                    <div class="setup-divider my-4"></div>

                    <button id="continueSubmit"
                            type="submit"
                            class="btn setup-button w-100"
                            disabled>
                        <span>Continue to authenticator setup</span>
                        <i class="bi bi-arrow-right"></i>
                    </button>

                    <p class="setup-footer mt-4 mb-0 text-center">
                        <i class="bi bi-shield-check me-1"></i>
                        Your account security matters.
                    </p>

                </form>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        (function () {
            const form = document.getElementById("setupForm");
            const newInput = document.getElementById("Input_NewPassword");
            const submitButton = document.getElementById("continueSubmit");
            const progressBar = document.getElementById("passwordStrength");
            const message = document.getElementById("passwordMessage");

            const tokenInput = form.querySelector('input[name="__RequestVerificationToken"]');
            const token = tokenInput ? tokenInput.value : "";

            let timeout = null;
            let requestNumber = 0;
            let passwordValid = false;

            function render(width, barClass, text, textClass) {
                progressBar.style.width = width;
                progressBar.className = "progress-bar " + barClass;
                message.className = "small mt-2 " + textClass;
                message.textContent = text;
                submitButton.disabled = !passwordValid;
            }

            function reset() {
                passwordValid = false;
                progressBar.style.width = "0%";
                progressBar.className = "progress-bar";
                message.textContent = "";
                submitButton.disabled = true;
            }

            async function checkPassword() {
                const password = newInput.value;
                const currentRequest = ++requestNumber;

                if (!password) {
                    reset();
                    return;
                }

                passwordValid = false;
                render("30%", "bg-danger", "Checking...", "text-muted");

                try {
                    const response = await fetch("?handler=CheckPassword", {
                        method: "POST",
                        headers: { "Content-Type": "application/x-www-form-urlencoded" },
                        body: new URLSearchParams({
                            password: password,
                            __RequestVerificationToken: token
                        })
                    });

                    if (!response.ok) {
                        throw new Error("Password validation failed.");
                    }

                    const result = await response.json();

                    if (currentRequest !== requestNumber) return;

                    if (result.valid) {
                        passwordValid = true;
                        render("100%", "bg-success", "Strong password!", "text-success");
                    } else {
                        const width = password.length >= 12 ? "75%" : "40%";
                        const barClass = password.length >= 12 ? "bg-warning" : "bg-danger";
                        render(width, barClass, result.errors?.[0] || "Invalid password.", "text-danger");
                    }
                } catch (error) {
                    if (currentRequest !== requestNumber) return;
                    passwordValid = false;
                    render("100%", "bg-danger", "Could not validate password.", "text-danger");
                }
            }

            newInput.addEventListener("input", () => {
                requestNumber++;
                passwordValid = false;
                submitButton.disabled = true;

                clearTimeout(timeout);
                timeout = setTimeout(checkPassword, 300);
            });
        })();
    </script>
}
