@page
@model LoginModel

@{
    ViewData["Title"] = "Log in";
}

<div class="container py-5">
    <div class="row justify-content-center align-items-center g-5">

        <!-- LOGIN FORM -->
        <div class="col-12 col-md-8 col-lg-5 order-2 order-lg-1">

            <div class="login-card p-4 p-md-5">

                <div class="login-heading mb-4">

                    <h1 class="login-title mt-3">
                        Log <span>in.</span>
                    </h1>

                    <p class="login-description">
                        Access your account to explore our equipment.
                    </p>
                </div>

                <form id="account" method="post">

                    <h2 class="login-subtitle mb-4">
                        Use your account credentials
                    </h2>

                    <div asp-validation-summary="ModelOnly"
                         class="text-danger validation-message mb-3"
                         role="alert">
                    </div>

                    <div class="form-floating mb-3">
                        <input asp-for="Input.Email"
                               class="form-control login-input"
                               autocomplete="username"
                               aria-required="true"
                               placeholder="name@example.com" />

                        <label asp-for="Input.Email" class="form-label">
                            Email address
                        </label>

                        <span asp-validation-for="Input.Email"
                              class="text-danger small">
                        </span>
                    </div>

                    <div class="form-floating mb-3">
                        <input asp-for="Input.Password"
                               class="form-control login-input"
                               autocomplete="current-password"
                               aria-required="true"
                               placeholder="password" />

                        <label asp-for="Input.Password" class="form-label">
                            Password
                        </label>

                        <span asp-validation-for="Input.Password"
                              class="text-danger small">
                        </span>
                    </div>

                    <div class="form-check mb-4">
                        <input class="form-check-input"
                               asp-for="Input.RememberMe" />

                        <label asp-for="Input.RememberMe"
                               class="form-check-label">
                            @Html.DisplayNameFor(m => m.Input.RememberMe)
                        </label>
                    </div>

                    <button id="login-submit"
                            type="submit"
                            class="btn btn-primary login-button w-100">
                        Log in
                        <span>↗</span>
                    </button>

                    <div class="login-links mt-4">
                        <p>
                            <a id="forgot-password" asp-page="./ForgotPassword">
                                Forgot your password?
                            </a>
                        </p>

                        <p>
                            <a asp-page="./Register"
                               asp-route-returnUrl="@Model.ReturnUrl">
                                Register as a new user
                            </a>
                        </p>

                        <p class="mb-0">
                            <a id="resend-confirmation"
                               asp-page="./ResendEmailConfirmation">
                                Resend email confirmation
                            </a>
                        </p>
                    </div>

                </form>

            </div>

        </div>

        <!-- RIGHT PANEL -->
        <div class="col-12 col-md-8 col-lg-5 order-1 order-lg-2">
            <div class="login-aside p-4 p-md-5">
                <span class="login-label">
                    PRECISION / QUALITY / CRAFT
                </span>

                <h2 class="aside-title mt-3 mb-3">
                    Where quality<br />
                    meets <span>precision.</span>
                </h2>

                <p class="aside-description">
                    Discover professional bakery equipment designed to
                    make every process more efficient, consistent and reliable.
                </p>

                <hr class="aside-divider my-4" />

            </div>

        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
