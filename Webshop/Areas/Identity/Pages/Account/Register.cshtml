
@page
@model RegisterModel
@{
    ViewData["Title"] = "Register";
}

<h1>@ViewData["Title"]</h1>

<div class="row">
    <div class="col-md-4">
        <form id="registerForm"
              asp-route-returnUrl="@Model.ReturnUrl"
              method="post">

            <h2>Create a new account.</h2>
            <hr />

            <div asp-validation-summary="ModelOnly"
                 class="text-danger"
                 role="alert"></div>

            <div class="form-floating mb-3">
                <input asp-for="Input.Email"
                       class="form-control"
                       autocomplete="username"
                       aria-required="true"
                       placeholder="name@example.com" />

                <label asp-for="Input.Email">Email</label>

                <span asp-validation-for="Input.Email"
                      class="text-danger"></span>
            </div>

            <div class="form-floating mb-2">
                <input asp-for="Input.Password"
                       class="form-control"
                       autocomplete="new-password"
                       aria-required="true"
                       placeholder="password" />

                <label asp-for="Input.Password">Password</label>

                <!-- <span asp-validation-for="Input.Password"
                      class="text-danger"></span> -->
            </div>

            <div class="progress mb-2 mt-2" style="height: 10px;">
                <div id="passwordStrength"
                     class="progress-bar"
                     role="progressbar"
                     style="width: 0%">
                </div>
            </div>

            <span id="passwordMessage" class="text-danger"></span>

            <div class="form-floating mb-3 mt-3">
                <input asp-for="Input.ConfirmPassword"
                       class="form-control"
                       autocomplete="new-password"
                       aria-required="true"
                       placeholder="password" />

                <label asp-for="Input.ConfirmPassword">
                    Confirm Password
                </label>

                <span asp-validation-for="Input.ConfirmPassword"
                      class="text-danger"></span>
            </div>

            <span id="confirmMessage" class="text-danger"></span>

            <button id="registerSubmit"
                    type="submit"
                    class="w-100 btn btn-lg btn-primary"
                    disabled>
                Register
            </button>
        </form>
    </div>

    <div class="col-md-6 col-md-offset-2">
        <section>
            <h3>Use another service to register.</h3>
            <hr />

            @if ((Model.ExternalLogins?.Count ?? 0) == 0)
            {
                <div>
                    <p>
                        There are no external authentication services configured.
                        See this
                        <a href="https://go.microsoft.com/fwlink/?LinkID=532715">
                            article about setting up this ASP.NET application
                            to support logging in via external services
                        </a>.
                    </p>
                </div>
            }
            else
            {
                <form id="external-account"
                      asp-page="./ExternalLogin"
                      asp-route-returnUrl="@Model.ReturnUrl"
                      method="post"
                      class="form-horizontal">

                    <div>
                        <p>
                            @foreach (var provider in Model.ExternalLogins!)
                            {
                                <button type="submit"
                                        class="btn btn-primary"
                                        name="provider"
                                        value="@provider.Name"
                                        title="Log in using your @provider.DisplayName account">
                                    @provider.DisplayName
                                </button>
                            }
                        </p>
                    </div>
                </form>
            }
        </section>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        const passwordInput = document.getElementById("Input_Password");
        const emailInput = document.getElementById("Input_Email");
        const confirmInput = document.getElementById("Input_ConfirmPassword");

        const progressBar = document.getElementById("passwordStrength");
        const message = document.getElementById("passwordMessage");
        const confirmMessage = document.getElementById("confirmMessage");

        const form = document.getElementById("registerForm");
        const registerButton = document.getElementById("registerSubmit");

        let timeout;
        let requestNumber = 0;
        let passwordValid = false;

        function updateRegisterButton() {
            const passwordsMatch =
                passwordInput.value === confirmInput.value &&
                confirmInput.value !== "";

            registerButton.disabled = !(passwordValid && passwordsMatch);

            if (confirmInput.value && !passwordsMatch) {
                confirmMessage.textContent = "Passwords do not match.";
            } else {
                confirmMessage.textContent = "";
            }
        }

        async function checkPassword() {
            const password = passwordInput.value;
            const email = emailInput.value;

            const currentRequest = ++requestNumber;

            passwordValid = false;
            updateRegisterButton();

            if (!password) {
                progressBar.style.width = "0%";
                progressBar.className = "progress-bar";
                message.textContent = "";
                updateRegisterButton();
                return;
            }

            progressBar.style.width = "30%";
            progressBar.className = "progress-bar bg-danger";

            message.className = "text-muted";
            message.textContent = "Checking...";

            const tokenInput = form.querySelector(
                'input[name="__RequestVerificationToken"]'
            );

            const token = tokenInput ? tokenInput.value : "";

            try {
                const response = await fetch("?handler=CheckPassword", {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/x-www-form-urlencoded"
                    },
                    body: new URLSearchParams({
                        password: password,
                        email: email,
                        __RequestVerificationToken: token
                    })
                });

                if (!response.ok) {
                    throw new Error("Password validation failed.");
                }

                const result = await response.json();

                // Ignore outdated responses
                if (currentRequest !== requestNumber) {
                    return;
                }

                if (result.valid) {
                    passwordValid = true;

                    progressBar.style.width = "100%";
                    progressBar.className = "progress-bar bg-success";

                    message.className = "text-success";
                    message.textContent = "Strong password!";
                } else {
                    passwordValid = false;

                    progressBar.style.width =
                        password.length >= 12 ? "75%" : "40%";

                    progressBar.className =
                        password.length >= 12
                            ? "progress-bar bg-warning"
                            : "progress-bar bg-danger";

                    message.className = "text-danger";

                    // Show only the first validation error
                    message.textContent =
                        result.errors?.[0] || "Invalid password.";
                }

                updateRegisterButton();

            } catch (error) {
                if (currentRequest !== requestNumber) {
                    return;
                }

                passwordValid = false;

                progressBar.className = "progress-bar bg-danger";
                message.className = "text-danger";
                message.textContent = "Could not validate password.";

                updateRegisterButton();
            }
        }

        passwordInput.addEventListener("input", () => {
            // Invalidate previous requests immediately
            requestNumber++;

            passwordValid = false;
            updateRegisterButton();

            clearTimeout(timeout);
            timeout = setTimeout(checkPassword, 300);
        });

        emailInput.addEventListener("input", () => {
            if (passwordInput.value) {
                requestNumber++;

                passwordValid = false;
                updateRegisterButton();

                clearTimeout(timeout);
                timeout = setTimeout(checkPassword, 300);
            }
        });

        confirmInput.addEventListener("input", updateRegisterButton);
    </script>
}
